# Use a hosted provider's OpenAI-compatible chat-completions endpoint.
# Keep this key on the server. Never put it in a VITE_ variable.
PORT=8787
AI_BASE_URL=https://YOUR-PROVIDER.example/v1
AI_API_KEY=replace_me
AI_MODEL=your-open-weight-model-id
# Optional. Leave false until the hosted model endpoint has been tested.
DEMO_FALLBACK=true